# Copy this file to .env and fill in one key. With no key, the offline reader is used.

# If set, the deal checker reads deals with Claude.
ANTHROPIC_API_KEY=

# Used when no Anthropic key is set.
GEMINI_API_KEY=

# Model name for the chosen provider.
LLM_MODEL=

# Set to "rules" to force the offline reader even when a key is present.
CHECKER_MODE=

# Set to "true" to allow only people who sign in with a wallet. Demo people are switched off.
REQUIRE_WALLET=

# Leave empty to use the local chain inside the server. Set it to the address of a public
# test network to run there instead, for example https://ethereum-sepolia-rpc.publicnode.com
# ("npm run testnet" uses that address without this line). Settl refuses real-money networks.
CHAIN_RPC_URL=

# How much test coin one rupee is, in wei. Leave empty for the defaults.
RUPEE_WEI=

PORT=3000

# Second port where wallets can reach the local chain.
RPC_PORT=8545
