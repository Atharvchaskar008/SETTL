# Copy this file to .env and fill in one key. With no key, the offline reader is used.

# If set, the deal checker reads deals with Claude.
ANTHROPIC_API_KEY=

# Used when no Anthropic key is set.
GEMINI_API_KEY=

# Model name for the chosen provider.
LLM_MODEL=

# Set to "rules" to force the offline reader even when a key is present.
CHECKER_MODE=

# Set to "true" to allow only people who sign in with a wallet. Demo people are switched off.
REQUIRE_WALLET=

PORT=3000

# Second port where wallets can reach the local chain.
RPC_PORT=8545
